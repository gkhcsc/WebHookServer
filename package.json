{
  "name": "webhook-server-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:server": "pnpm --filter @webhook/server run dev",
    "dev:frontend": "pnpm --filter @webhook/frontend run dev",
    "build": "pnpm --filter @webhook/frontend run build",
    "start": "node setup.mjs && node start.mjs",
    "start:server": "pnpm --filter @webhook/server run start"
  }
}
